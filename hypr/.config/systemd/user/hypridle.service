[Unit]
Description=Hyprland idle daemon (auto-restart on crash)
Documentation=https://wiki.hyprland.org/Hypr-Ecosystem/hypridle

[Service]
ExecStart=/usr/bin/hypridle
# hypridle spawns lock_cmd's hyprlock into THIS unit's cgroup, so the default
# KillMode=control-group tears the live lock screen down on every stop/restart
# — including the automatic Restart=on-failure below. That left the desktop
# exposed until the next 300s idle timeout re-locked it. KillMode=process
# signals only hypridle itself, so an in-progress hyprlock outlives the daemon.
KillMode=process
Restart=on-failure
RestartSec=1
StartLimitBurst=10
StartLimitIntervalSec=60

[Install]
WantedBy=default.target
