#!/usr/bin/env bash

tmp_dir="/tmp/cliphist"

# Handle selection (piped from rofi)
if [[ -n "$1" ]]; then
    selected="$1"
elif [[ ! -t 0 ]]; then
    read -r selected
fi

if [[ -n "$selected" ]]; then
    # Look up the ID from our mapping file
    id=$(grep -Fm1 "$selected" "$tmp_dir/map" 2>/dev/null | cut -f1)
    if [[ -n "$id" ]]; then
        echo -e "$id\t$selected" | cliphist decode | wl-copy
    else
        cliphist decode <<<"$selected" | wl-copy
    fi
    exit
fi

# Generate list
# INCREMENTAL. This used to `rm -rf "$tmp_dir"` and re-decode every image in the
# history on EVERY invocation. With ~750 entries that took over two minutes, so
# both rofi and the Quickshell clipboard appeared to hang on open.
#
# cliphist ids are stable and content-addressed: an id that is already decoded
# on disk can never mean a different image. So keep the cache and only decode
# what is missing. The map is still rebuilt each run because it is cheap (one
# `cliphist list`) and must not go stale.
mkdir -p "$tmp_dir"
rm -f "$tmp_dir/map"

# -preview-width: cliphist's list output defaults to 100 characters per entry
# and appends an ellipsis. That truncated string is the ONLY text the
# Quickshell preview pane ever receives, so a long entry was unreadable there
# no matter how much room the pane had. 2000 covers a screenful of the pane
# and costs nothing -- the list rows still elide to one line.
# (`cliphist decode` keys off the leading id and ignores the preview text,
# so the selection path below is unaffected by the wider line.)
cliphist -preview-width 2000 list | while IFS=$'\t' read -r id content; do
    [[ "$content" == *"<meta http-equiv="* ]] && continue

    printf '%s\t%s\n' "$id" "$content" >> "$tmp_dir/map"

    if [[ "$content" =~ binary.*\ (jpg|jpeg|png|bmp) ]]; then
        ext="${BASH_REMATCH[1]}"
        # Only decode when it is not already cached (and non-empty: a
        # truncated file from an interrupted run must be redone).
        [[ -s "$tmp_dir/$id.$ext" ]] || echo -e "$id\t" | cliphist decode > "$tmp_dir/$id.$ext" 2>/dev/null
        display="[image:$id]"
        printf '%s\t%s\n' "$id" "$display" >> "$tmp_dir/map"
        printf '%s\0icon\x1f%s/%s.%s\n' "$display" "$tmp_dir" "$id" "$ext"
    else
        printf '%s\n' "$content"
    fi
done
