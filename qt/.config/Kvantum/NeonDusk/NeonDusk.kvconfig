frame.right=1
text.bold=true
text.normal.color=#a891d0
text.focus.color=#f3e9ff
text.toggle.color=#f3e9ff
frame.expansion=0

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
frame=false
interior.element=menubar
frame.element=menubar
text.normal.color=#f3e9ff
text.focus.color=#f3e9ff
frame.bottom=0
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.normal.color=#f3e9ff
text.focus.color=#f3e9ff
text.press.color=#f3e9ff
text.toggle.color=#f3e9ff
text.bold=false
frame.expansion=8
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
text.margin=0
frame.element=itemview
interior.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#f3e9ff
text.focus.color=#f3e9ff
text.press.color=#2de2e6
text.toggle.color=#2de2e6
text.focus.inactive.color=#f3e9ff
text.press.inactive.color=#2de2e6
text.toggle.inactive.color=#2de2e6
frame.expansion=0

[Splitter]
indicator.size=48

[Scrollbar]
inherits=PanelButtonCommand
