frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=64

[Menu]
inherits=PanelButtonCommand
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
frame.element=menu
interior.element=menu
text.normal.color=#1a1d18
text.shadow=false
frame.expansion=0

[GroupBox]
inherits=GenericFrame
