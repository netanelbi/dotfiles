[Unit]
Description=Socket for Ori's agent broker
# Deliberately socket-activated rather than started from Hyprland's
# exec-once. Two things fall out of it that the exec-once shape does not
# give: the socket exists from login, so the panel's connect never has to
# race a daemon coming up or retry against a missing path; and nothing runs
# behind it until that connect happens, which is the same "nothing exists
# until it is asked for" rule the launchers and the share picker follow.
# The broker is also then independent of the graphical session entirely --
# it is a socket in $XDG_RUNTIME_DIR, not a Wayland client.

[Socket]
# %t is $XDG_RUNTIME_DIR. Not /tmp: a lock file this shell put in /tmp once
# locked root out of it under fs.protected_regular, and the runtime dir is
# where the rest of this desktop's state already lives.
ListenStream=%t/ori-agent.sock
SocketMode=0600

[Install]
WantedBy=sockets.target
