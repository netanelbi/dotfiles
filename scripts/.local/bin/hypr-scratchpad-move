#!/bin/bash
# Move window to scratchpad and update waybar

silent="$1"

if [ "$silent" == "silent" ]; then
    hyprctl dispatch 'hl.dsp.window.move({ workspace = "special:magic", follow = false })'
else
    hyprctl dispatch 'hl.dsp.window.move({ workspace = "special:magic" })'
fi

# Update waybar indicator
pkill -RTMIN+8 waybar
