#!/usr/bin/env python3
"""Follow the kernel log and fsync every line to disk immediately.

Purpose: capture the last kernel printks (amdgpu REG_WAIT/DMUB/EDID errors,
lockups) right before a hard hang/reboot that leaves journald's own buffers
unflushed. Persistent-journald still loses the final lines on a hard reset;
this survives because each line hits the platter before the next is read.

Temporary diagnostic for the DCN 3.5 dpms-off reboot hunt. Remove the stow
symlink + `systemctl --user disable --now kernel-crash-logger` once a trace
is captured and the root cause is settled.
"""
import os
import subprocess
import sys
import time

LOG = os.path.expanduser("~/kernel-crash.log")


def main():
    with open(LOG, "a", buffering=1) as f:
        f.write(f"\n===== logger start (boot uptime {time.monotonic():.1f}s) =====\n")
        f.flush()
        os.fsync(f.fileno())
        proc = subprocess.Popen(
            ["journalctl", "-kf", "-o", "short-precise", "--since", "now"],
            stdout=subprocess.PIPE,
            text=True,
        )
        for line in proc.stdout:
            f.write(line)
            f.flush()
            os.fsync(f.fileno())


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
