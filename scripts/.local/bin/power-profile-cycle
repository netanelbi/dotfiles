#!/bin/bash
# Cycle power profiles: power-saver → balanced → performance
# vivo (AMD) additionally gets per-profile TDP + the 2GHz freq-cap fix from
# ppd-tdp-watch, which reacts to the profile change; Intel has no such watcher.

current=$(powerprofilesctl get)
case "$current" in
    power-saver) new=balanced;    icon="󰗑"; urgency=normal;;
    balanced)    new=performance; icon="󰓅"; urgency=critical;;
    *)           new=power-saver; icon="󰌪"; urgency=low;;
esac

powerprofilesctl set "$new"

notify-send -a power-profile -t 1500 -u "$urgency" \
    -h string:x-canonical-private-synchronous:power \
    "$icon $new"

# Dismiss critical notifications after 2s (swaync ignores timeout for critical)
if [ "$urgency" = "critical" ]; then
    (sleep 2 && swaync-client --close-latest) &
fi

# TDP + freq fix: NOT called from here. ppd-tdp-watch (vivo) applies the hook on
# the profile-change signal, and this script always changes the profile. Calling
# the hook here too ran ryzenadj twice per press, back to back, on top of the
# firmware's own limit reprogramming — and every ryzenadj mailbox write is a
# collision risk against amdgpu/amdxdna SMU traffic (2026-09-22 hard freeze on a
# single press, see memory ryzenadj_smu_freeze). Halve the exposure.

# Clear custom TDP (profile sets default); tdp-watch picks this up via inotify (vivo)
rm -f /tmp/tdp-state