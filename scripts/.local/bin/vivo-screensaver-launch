#!/bin/bash
# Open the VIVO screensaver in a fullscreen kitty on the focused monitor.
# Bind this (not vivo-screensaver) to a key, or call it from an idle timer.

set -uo pipefail

# Already up? Don't stack a second one.
pgrep -f '[o]rg.vivo.screensaver' >/dev/null && exit 0

# Never start over a locked session. hypridle fires the screensaver at 150s and
# locks at 300s, but a lock can also arrive early (loginctl lock-session, lid
# close, SUPER+L) -- without this the screensaver would spawn behind hyprlock and
# spin a tte loop nobody can see.
pidof hyprlock >/dev/null && exit 0

# The window rule in hypr keys off this class; kitty sets it with --class.
exec kitty --class org.vivo.screensaver \
           --title "VIVO screensaver" \
           -o confirm_os_window_close=0 \
           -o window_padding_width=0 \
           -e "$HOME/.local/bin/vivo-screensaver"
