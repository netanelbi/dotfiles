# Start one pad-hotkey@eventN user unit per gamepad (Guide + R3 -> MangoHud toggle).
# Unit and source: the scripts stow package (pad-hotkey@.service, .local/src/pad-hotkey).
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="pad-hotkey@%k.service"
