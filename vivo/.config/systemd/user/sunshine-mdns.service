[Unit]
Description=Advertise Sunshine over mDNS so Moonlight can discover it (vivo)
# Sunshine's own avahi publisher is dead here: avahi-daemon is disabled because
# systemd-resolved owns UDP 5353. See the header of ~/.local/bin/sunshine-mdns.
After=network-online.target app-dev.lizardbyte.app.Sunshine.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/sunshine-mdns
# Exits non-zero while wlan0 has no address yet (boot race, WiFi down); retry.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
