#!/usr/bin/env bash
# hypr-display-toggle — SUPER+O: lock + blank the screens, and rescue them back.
#
# Bound `locked = true` (machine.lua) so it works from the lock screen, which is
# the whole point: this is what you press when the screen is black and you cannot
# see what you are typing.
#
# Three behaviours, picked from live state:
#   1. RESCUE — a physical panel is DISABLED (sunshine-prep disables eDP-1 and
#      DP-2 for the duration of a stream so Sunshine cannot capture a physical
#      panel; a stream that dies without unprep leaves the laptop looking dead).
#      Re-assert both monitors from config, dpms on, move focus somewhere visible.
#   2. BLANK — panels enabled and lit: lock the session, then dpms off.
#   3. WAKE — panels enabled and blanked: dpms on.
#
# During an active stream it does nothing: the panels are disabled on purpose,
# and blanking/locking would land on the remote client.
#
# ON THE DPMS-OFF REBOOT (memory amdgpu_dpms_reboot): dpms-off on this 890M hits
# a DCN 3.5 IPS/dc_lock race that hard-reboots the box. That is MITIGATED, not
# avoided — `amdgpu.dcdebugmask=0x800` (DC_DISABLE_IPS) is on the kernel cmdline
# and kills the racing code path outright. hypridle blanks with the same
# `hl.dsp.dpms` call on its 330s timeout every day, so this key is no riskier
# than the idle timer already is. If the crash ever returns, the cmdline flag is
# the thing to check first, not this script.
#
# NOTE the syntax: `hyprctl keyword` is REJECTED under the Lua config provider
# ("keyword can't work with non-legacy parsers. Use eval."). Every monitor line
# in sunshine-prep/unprep was silently dead for a week because of exactly this.
# Use `hyprctl eval` + hl.monitor(), matching monitor.lua.

set -uo pipefail   # no -e: attempt every step even if one output is absent

STREAM_MARKER="${XDG_RUNTIME_DIR:-/tmp}/sunshine-prep/stream-active"

# Hyprland 0.55+ stopped exporting HYPRLAND_INSTANCE_SIGNATURE reliably into the
# systemd user env, and /run/user/1000/hypr accumulates dead socket dirs. Pick the
# one whose lock file names a live pid.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    for dir in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/"*/; do
        pid=$(head -n1 "$dir/hyprland.lock" 2>/dev/null || true)
        [[ -n "$pid" && -d "/proc/$pid" ]] || continue
        HYPRLAND_INSTANCE_SIGNATURE=$(basename "$dir")
        export HYPRLAND_INSTANCE_SIGNATURE
        break
    done
fi

rescue() {
    # Values mirror monitor.lua. The Dell is matched by desc: — its connector
    # alternates DP-1/DP-2 depending on which port it is plugged into.
    timeout 3 hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "1920x1200@60", position = "1920x0", scale = 1.5, disabled = false })' >/dev/null 2>&1
    timeout 3 hyprctl eval 'hl.monitor({ output = "desc:Dell Inc. DELL P2722H", mode = "1920x1080@60", position = "0x0", scale = 1, disabled = false })' >/dev/null 2>&1
    timeout 3 hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' >/dev/null 2>&1
    # Put focus somewhere visible — after a failed stream the active workspace can
    # still be `stream`, parked on a headless output you cannot see.
    timeout 3 hyprctl dispatch 'hl.dsp.focus({ monitor = "eDP-1" })' >/dev/null 2>&1
    notify-send -a display-rescue "Displays" "Physical panels forced back on" 2>/dev/null || true
}

# Mid-stream the panels are disabled deliberately — leave everything alone.
[[ -f "$STREAM_MARKER" ]] && exit 0

mons=$(timeout 3 hyprctl monitors all -j 2>/dev/null)
[[ -z "$mons" ]] && { rescue; exit 0; }

# 1. Any physical panel disabled -> rescue.
if jq -e 'any(.[]; .disabled and (.name | startswith("HEADLESS") | not))' <<<"$mons" >/dev/null 2>&1; then
    rescue
    exit 0
fi

# 2/3. Toggle dpms on the physical panels. No HEADLESS output exists outside a
# stream, and streams already exited above, so the global dispatch is safe here.
if jq -e 'any(.[]; (.name | startswith("HEADLESS") | not) and (.disabled | not) and .dpmsStatus)' <<<"$mons" >/dev/null 2>&1; then
    loginctl lock-session
    sleep 0.5   # let the keypress settle so key_press_enables_dpms doesn't undo the blank
    timeout 3 hyprctl dispatch 'hl.dsp.dpms({ action = "off" })' >/dev/null 2>&1
else
    timeout 3 hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' >/dev/null 2>&1
fi
