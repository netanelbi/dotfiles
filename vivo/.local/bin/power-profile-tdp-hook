#!/bin/bash
# power-profile-tdp-hook — vivo (AMD) only. Installed by the vivo/ stow package.
#
# Sets ryzenadj TDP per power profile and fixes the 2GHz amd_pstate freq cap.
# Called only if present (presence-checked by the caller) from:
#   - power-profile-auto   (udev, runs as root)
#   - power-profile-cycle  (keybinding, runs as user)
# Intel machines don't install this file, so those scripts skip it cleanly.
# (sunshine-prep/unprep are vivo-only and apply TDP inline, not via this hook.)
#
# Usage: power-profile-tdp-hook <power-saver|balanced|performance>

profile="$1"

# Serialize all SMU access. Concurrent runs — spamming SUPER+B, or a keybind
# cycle overlapping the udev AC handler — fire overlapping ryzenadj writes to
# the single SMU mailbox, desyncing it. The SMU then stops responding
# ("amdgpu: SMU: No response") and the whole machine hard-freezes (gfx ring +
# ACPI + xhci death). World-writable lock so both the user (keybind) and root
# (udev) callers share it; non-blocking so extra invocations are dropped, not
# queued. See memory: ryzenadj_smu_freeze.
LOCK=/tmp/power-profile-tdp-hook.lock
[ -e "$LOCK" ] || (umask 0; : > "$LOCK")
exec 9>>"$LOCK"
flock -n 9 || exit 0

# Run ryzenadj/fix-cpu-freq as root when invoked by udev, via sudo -n when invoked
# by a user keybind (NOPASSWD sudoers expected; -n avoids hanging on a prompt).
if [ "$(id -u)" = 0 ]; then ASROOT=; else ASROOT="sudo -n"; fi

# Limits below are measured, not guessed (24-thread sustained load, 2026-08-14):
#   45W is this chassis's hard package ceiling — with stapm/fast/slow all at 65000
#   and tctl 90/95/100, the SMU delivers 45.00W and ~89C every time. The old 54W
#   setting was unreachable, and at tctl 100 it ran 96C for LESS clock than 45W
#   (thermal throttling oscillates; a clean power cap runs steady).
#   Measured landing points on the matching fan curve:
#     balanced    31W -> 78.5C, P-core 3051MHz   (quiet, stays under 80C)
#     performance 45W -> 87.8C, P-core 3543MHz   (the real maximum)
#   tctl is a safety net set just above where each wattage settles, NOT the control
#   knob: limiting by tctl instead of watts cost 18% clock at the same temperature.
# Errors are deliberately NOT redirected — ryzenadj silently no-ops if the SMU
# rejects a limit, and /dev/mem readback is blocked (CONFIG_IO_STRICT_DEVMEM), so
# stderr is the only signal that a limit actually applied.
case "$profile" in
    power-saver) $ASROOT ryzenadj --stapm-limit=15000 --fast-limit=20000 --slow-limit=15000 --tctl-temp=75 ;;
    balanced)    $ASROOT ryzenadj --stapm-limit=31000 --fast-limit=37000 --slow-limit=31000 --tctl-temp=85 ;;
    performance) $ASROOT ryzenadj --stapm-limit=45000 --fast-limit=51000 --slow-limit=45000 --tctl-temp=92 ;;
esac

# Fix the 2GHz amd_pstate cap for balanced/performance only (power-saver needs the lower cap)
[ "$profile" != "power-saver" ] && $ASROOT /home/netanel/.local/bin/fix-cpu-freq 2>/dev/null