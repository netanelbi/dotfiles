#!/usr/bin/env bash
# sunshine-blank — darken the desk for a stream WITHOUT ever reaching
# "all displays off".
#
#   sunshine-blank on    # called by sunshine-prep
#   sunshine-blank off   # called by sunshine-unprep and sunshine-blank-watch
#
# THE RULE THIS EXISTS TO ENFORCE
# sunshine-prep used to disable BOTH physical panels, leaving HEADLESS-1 as the
# only output. HEADLESS-1 is a virtual wlroots output with no display engine
# behind it, so the GPU saw zero active displays -- the one state that arms IPS2
# on this DCN 3.5 part and hard-resets the machine (memory: amdgpu_dpms_reboot;
# it took the box down at stream start on 2026-09-20 11:19).
#
# So: disable every physical output EXCEPT one "keeper", which stays enabled and
# scanning out, and is merely made to emit no light.
#
#   keeper = eDP-1   -> backlight to 0. A true 0 on this panel (measured), and
#                       the desktop keeps rendering underneath, so if Sunshine
#                       ever grabs eDP-1 instead of HEADLESS-1 the remote player
#                       sees a usable desktop rather than a black rectangle.
#   keeper = other   -> the black overlay (quickshell gameblank). Only reachable
#                       with the lid shut, where eDP-1 is already disabled and an
#                       external is all that is left; its backlight is not ours
#                       to control (the Dell's DDC/CI does not answer over its
#                       USB-C->DP adapter, tested 2026-09-23).
#
# `monitor disabled = true` is used rather than `dpms off` deliberately: it takes
# one named output, it is already used all over this repo, and it never touches
# the global dpms path.
set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/sunshine-prep"
MODE_FILE="$STATE_DIR/blank-mode"
QS=(qs -p "$HOME/.config/quickshell" ipc call gameblank)

mkdir -p "$STATE_DIR"

case "${1:-}" in
on)
    # `hyprctl monitors` (no `all`) lists only ENABLED outputs.
    mapfile -t physical < <(hyprctl monitors -j 2>/dev/null |
        jq -r '.[] | select(.name | startswith("HEADLESS") | not) | .name')

    # Nothing enabled (lid shut, externals unplugged): there is nothing to
    # darken, and disabling anything here is what the whole file is about.
    [[ ${#physical[@]} -eq 0 ]] && exit 0

    keeper="${physical[0]}"
    for m in "${physical[@]}"; do
        [[ "$m" == "eDP-1" ]] && keeper="eDP-1"
    done

    for m in "${physical[@]}"; do
        [[ "$m" == "$keeper" ]] && continue
        hyprctl eval "hl.monitor({ output = \"$m\", disabled = true })" >/dev/null || true
    done

    if [[ "$keeper" == "eDP-1" ]]; then
        brightnessctl --save set 0 >/dev/null 2>&1 && echo backlight > "$MODE_FILE"
    else
        "${QS[@]}" start >/dev/null 2>&1 && echo overlay > "$MODE_FILE"
    fi
    ;;
off)
    case "$(cat "$MODE_FILE" 2>/dev/null)" in
        backlight) brightnessctl --restore >/dev/null 2>&1 || true ;;
        overlay)   "${QS[@]}" stop >/dev/null 2>&1 || true ;;
    esac
    rm -f "$MODE_FILE"
    ;;
*)
    echo "usage: sunshine-blank on|off" >&2
    exit 2
    ;;
esac
exit 0
